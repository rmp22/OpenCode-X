#!/bin/bash
set -eo pipefail
cd "$(dirname "$0")/packages/opencode"
bun install --frozen-lockfile 2>/dev/null || true
VERSION="$(node -p "require('./package.json').version")"
OPENCODE_VERSION="$VERSION" bun run script/build.ts --single --skip-embed-web-ui --skip-install
echo "Built ocx v$VERSION. Run: bash deploy"
