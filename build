#!/bin/bash
set -e
cd "$(dirname "$0")/packages/opencode"
npx bun install 2>/dev/null
VERSION="$(node -p "require('./package.json').version")"
OPENCODE_VERSION="$VERSION" npx bun run script/build.ts --single --skip-embed-web-ui --skip-install 2>&1 | tail -3
echo "Built ocx v$VERSION. Run: bash deploy"
